---
// Platforms.astro

const mainPlatforms = [
  {
    title: "Linux Ecosystem",
    badge: "38+ Distros Supported",
    headline: "Direct Sysfs & /proc Kernel Telemetry",
    description: "Parses kernel telemetry directly with zero subprocess forks. Automatically detects 38+ distributions, desktop environments, package managers, and hardware sensors.",
    highlights: ["Fedora", "Arch", "Ubuntu", "Debian", "NixOS", "SteamOS", "Void", "Alpine", "+30 more"],
    stat: "0 Child Forks",
    statLabel: "Pure Go Syscall Engine",
    icon: `<svg class="w-6 h-6 text-[#00ADD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    title: "Apple macOS",
    badge: "Apple Silicon & Intel",
    headline: "Native Mach Kernel & Metal Memory",
    description: "Deep integration with macOS Mach subsystems, host statistics, and Apple Metal unified memory telemetry across M1, M2, M3, and M4 chips.",
    highlights: ["Apple Silicon M1-M4", "Intel x86_64", "Ghostty / Warp", "iTerm2 / Terminal"],
    stat: "Unified RAM",
    statLabel: "Metal GPU Telemetry",
    icon: `<svg class="w-6 h-6 text-[#00ADD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    title: "Windows & BSD",
    badge: "ConPTY & KVM",
    headline: "Windows Terminal & BSD KVM Queries",
    description: "Optimized ConPTY virtual terminal sequences with zero flicker for Windows 11/10, alongside native KVM queries for FreeBSD, OpenBSD, and NetBSD.",
    highlights: ["Windows Terminal", "PowerShell 7", "FreeBSD (Tier 1)", "OpenBSD sandbox"],
    stat: "Zero CGO",
    statLabel: "Single Static Binaries",
    icon: `<svg class="w-6 h-6 text-[#00ADD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" /></svg>`
  }
];

const archList = [
  { name: "x86_64 / amd64", note: "Linux • macOS • Windows • BSD" },
  { name: "ARM64 / aarch64", note: "Apple Silicon • Linux ARM • Win ARM" }
];
---

<section id="platforms" class="py-16 sm:py-24 lg:py-28 relative overflow-hidden">
  
  <!-- Subtle Ambient Glow Background -->
  <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
    <div class="w-[600px] h-[350px] bg-[#00ADD8]/6 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00ADD8]/10 text-[#00ADD8] border border-[#00ADD8]/30 text-xs font-mono font-medium mb-3 sm:mb-4">
        <span>// CROSS-PLATFORM SUPPORT</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        One binary. <br class="hidden sm:inline" />
        <span class="text-gradient-go">Runs natively everywhere.</span>
      </h2>
      <p class="mt-3 text-slate-400 text-sm sm:text-base lg:text-lg max-w-2xl mx-auto">
        Compiled into single static native binaries with zero CGO dependencies. First-class support across 38+ Linux distributions, macOS, Windows, and BSD.
      </p>
    </div>

    <!-- Clean 3-Column Bento Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10 max-w-6xl mx-auto">
      {mainPlatforms.map((p) => (
        <div class="glass-card glass-card-hover rounded-2xl p-6 sm:p-7 flex flex-col justify-between relative group border border-slate-800 hover:border-[#00ADD8]/50 transition-all duration-300">
          
          <div>
            <!-- Card Header: Icon + Badge -->
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-center group-hover:border-[#00ADD8]/50 group-hover:shadow-glow-sm transition-all">
                <Fragment set:html={p.icon} />
              </div>
              <span class="text-[11px] font-mono font-semibold px-2.5 py-1 rounded-md bg-[#00ADD8]/10 text-cyan-300 border border-[#00ADD8]/20">
                {p.badge}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-bold text-white group-hover:text-cyan-200 transition-colors">
              {p.title}
            </h3>
            <div class="text-xs font-mono text-[#00ADD8] mt-1 mb-3">
              {p.headline}
            </div>
            
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
              {p.description}
            </p>

            <!-- Curated Highlight Pills -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {p.highlights.map((item) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-900/90 text-slate-300 border border-slate-800/80">
                  {item}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Metric Strip -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <div>
              <div class="text-xs font-mono font-bold text-white">{p.stat}</div>
              <div class="text-[10px] font-mono text-slate-500">{p.statLabel}</div>
            </div>
            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
          </div>

        </div>
      ))}
    </div>

    <!-- Supported Architecture Strip -->
    <div class="max-w-6xl mx-auto rounded-2xl bg-[#0c111c]/80 border border-slate-800/80 p-5 backdrop-blur-md">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        
        <div class="flex items-center gap-3 text-left w-full md:w-auto">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#00ADD8]/20 to-blue-600/10 border border-[#00ADD8]/40 flex items-center justify-center text-[#00ADD8] font-mono font-bold text-xs flex-shrink-0">
            GO
          </div>
          <div>
            <div class="text-xs font-bold text-white">Multi-Architecture GoReleaser Artifacts</div>
            <div class="text-[11px] text-slate-400 font-mono">Static binaries compiled with zero runtime CGO</div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full md:w-auto">
          {archList.map((a) => (
            <div class="p-2.5 px-4 rounded-xl bg-slate-900/80 border border-slate-800 text-left w-full">
              <div class="text-xs font-mono font-bold text-cyan-300 truncate">{a.name}</div>
              <div class="text-[10px] font-mono text-slate-500 truncate mt-0.5">{a.note}</div>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>


