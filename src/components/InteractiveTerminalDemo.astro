  "      .;cccccccccccccccccccccc;.",
  "    .:cccccccccccccccccccccc:.",
  "  .;ccccccccccccc;.:dddl:.;ccccccc;.",
  " .:ccccccccccccc;OWMKOOXMWd;ccccccc:.",
