const jsonRawOutput = `{
  "OS": "Fedora Linux 44 (KDE Plasma)",
  "Kernel": "7.1.8-200.fc44.x86_64",
  "Uptime": "25 mins",
  "CPU": "Intel Pentium Silver N5030 @ 1.10GHz",
  "CPUUsage": "0.4%",
  "GPU": "Intel GeminiLake [UHD Graphics 605]",
  "RAM": "1.8GB / 3.6GB (49%)",
  "Disk": "16.8GB / 337.8GB (5%)",
  "Hostname": "fedora",
  "IPAddress": "10.126.203.85",
