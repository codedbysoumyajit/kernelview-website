              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview -g</span>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4 lg:gap-8 items-start">
              <div class="text-[#38bdf8] font-bold select-none whitespace-pre font-mono text-xs sm:text-sm leading-tight flex-shrink-0">
{intelAscii.join('\n')}
              </div>
              <div class="flex-1 space-y-1 font-mono text-xs sm:text-sm text-slate-200">
                <div class="font-bold text-[#38bdf8] mb-0.5">soumyajit@fedora</div>
                <div class="text-slate-500 select-none pb-1">----------------</div>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-[#38bdf8] font-bold min-w-[90px] sm:min-w-[95px]">GPU Model:</span>
                  <span class="text-slate-300">Intel GeminiLake [UHD Graphics 605]</span>
                </div>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-[#38bdf8] font-bold min-w-[90px] sm:min-w-[95px]">Vendor:</span>
                  <span class="text-slate-300">Intel</span>
                </div>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-[#38bdf8] font-bold min-w-[90px] sm:min-w-[95px]">Driver:</span>
                  <span class="text-slate-300">i915</span>
                </div>
                
                <!-- Color Blocks -->
                <div class="pt-4 sm:pt-5 space-y-1 select-none">
                  <div class="flex gap-1.5">
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-zinc-950 border border-slate-700/50 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-red-600 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-green-600 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-yellow-500 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-[#00ADD8] rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-purple-600 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-cyan-400 rounded-xs inline-block"></span>
                    <span class="w-5 sm:w-6 h-3.5 sm:h-4 bg-slate-200 rounded-xs inline-block"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Network Output View -->
          <div id="out-net" class="demo-pane hidden">
            <div class="text-slate-400 mb-3 sm:mb-4 font-mono text-xs flex items-center gap-1.5 sm:gap-2 flex-wrap">
              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview -n</span>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4 lg:gap-8 items-start">
              <div class="text-[#38bdf8] font-bold select-none whitespace-pre font-mono text-xs sm:text-sm leading-tight flex-shrink-0">
{fedoraAsciiLines.join('\n')}
              </div>
              <div class="flex-1 space-y-0.5 font-mono text-xs sm:text-sm text-slate-200">
                <div class="font-bold text-[#38bdf8] mb-0.5">soumyajit@fedora (Network)</div>
                <div class="text-slate-500 select-none pb-1">--------------------------</div>
                
                {networkSpecs.map((spec) => (
                  <div class="flex flex-col xs:flex-row xs:items-baseline gap-0.5 xs:gap-1.5 min-w-0 py-0.2">
                    <span class="text-[#38bdf8] font-bold xs:min-w-[100px] flex-shrink-0">{spec.key}:</span>
                    <span class="text-slate-300 break-words min-w-0">{spec.value}</span>
                  </div>
                ))}

                <!-- Color Blocks -->
                <div class="pt-4 sm:pt-5 space-y-1 select-none overflow-x-auto no-scrollbar">
                  <div class="flex gap-1 sm:gap-1.5 flex-nowrap">
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-zinc-950 border border-slate-700/50 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-red-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-green-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-yellow-500 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-[#00ADD8] rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-purple-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-cyan-400 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-slate-200 rounded-xs inline-block flex-shrink-0"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Process Output View -->
          <div id="out-proc" class="demo-pane hidden">
            <div class="text-slate-400 mb-3 sm:mb-4 font-mono text-xs flex items-center gap-1.5 sm:gap-2 flex-wrap">
              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview -p</span>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4 lg:gap-8 items-start">
              <div class="text-[#38bdf8] font-bold select-none whitespace-pre font-mono text-xs sm:text-sm leading-tight flex-shrink-0">
{fedoraAsciiLines.join('\n')}
              </div>
              <div class="flex-1 space-y-0.5 font-mono text-xs sm:text-sm text-slate-200">
                <div class="font-bold text-[#38bdf8] mb-0.5">soumyajit@fedora (Processes)</div>
                <div class="text-slate-500 select-none pb-1">----------------------------</div>
                <div class="flex items-center gap-4 text-[#38bdf8] font-bold text-xs">
                  <span class="w-16">PID</span>
                  <span>NAME</span>
                </div>
                <div class="text-slate-600 select-none pb-1">─────────────────────────────────────</div>
                
                {processList.map((proc) => (
                  <div class="flex items-center gap-4 text-xs font-mono">
                    <span class="w-16 text-cyan-400">{proc.pid}</span>
                    <span class="text-slate-300">{proc.name}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Help Menu View -->
          <div id="out-help" class="demo-pane hidden">
            <div class="text-slate-400 mb-3 sm:mb-4 font-mono text-xs flex items-center gap-1.5 sm:gap-2 flex-wrap">
              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview --help</span>
            </div>
            <pre class="text-[#38bdf8] font-mono text-xs sm:text-sm whitespace-pre-wrap leading-relaxed"><code>{helpMenu}</code></pre>
          </div>

        </div>

        <!-- Terminal Prompt Footer -->
        <div class="bg-[#0f1420] px-3.5 sm:px-4 py-2.5 sm:py-3 border-t border-slate-800 flex items-center justify-between text-xs font-mono text-slate-400">
          <div class="flex items-center gap-2 truncate">
            <span class="text-[#00ADD8] font-bold">➜</span>
            <span class="text-cyan-400">~</span>
            <span class="text-slate-300 truncate">Run <kbd class="px-1.5 py-0.5 bg-slate-900 rounded border border-slate-700 text-cyan-300 font-semibold text-[10px] sm:text-xs">kernelview</kbd> in terminal</span>
          </div>
          <span class="text-slate-400 hidden sm:inline flex-shrink-0">go1.26.6 / go1.27.0 • x86_64</span>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const cmdButtons = document.querySelectorAll<HTMLButtonElement>('.demo-cmd-btn');
  const demoPanes = document.querySelectorAll<HTMLDivElement>('.demo-pane');

  cmdButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const outputType = btn.getAttribute('data-output');

      cmdButtons.forEach((b) => {
        b.classList.remove('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-demo');
        b.classList.add('bg-[#0f1420]/70', 'text-slate-400', 'border-slate-800');
      });

      btn.classList.remove('bg-[#0f1420]/70', 'text-slate-400', 'border-slate-800');
      btn.classList.add('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-demo');

      demoPanes.forEach((pane) => {
        if (pane.id === `out-${outputType}`) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });
    });
  });
</script>
