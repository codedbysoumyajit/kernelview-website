const intelAscii = [
  " ___ _   _ _____ _____ _     ",
  "|_ _| \\ | |_   _| ____| |    ",
  " | ||  \\| | | | |  _| | |    ",
  " | || |\\  | | | | |___| |___ ",
  "|___|_| \\_| |_| |_____|_____|"
];

const helpMenu = `USAGE: kernelview [flags]

DISPLAY MODES:
  -l, --live         Start real-time TUI dashboard
  -p, --process      Display static list of running processes
  -n, --network      Display network interfaces & latency
  -g, --gpu          Display GPU & graphics API report
  [default]          Display system fetch with ASCII logo

CONFIGURATION:
  -f, --fast         Run fast mode (skip slow subsystem checks)
  --json             Output information as structured JSON
  --no-color         Disable ANSI color formatting`;
---

<section id="demo" class="py-12 sm:py-16 lg:py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00ADD8]/10 text-[#00ADD8] border border-[#00ADD8]/30 text-xs font-mono font-medium mb-3 shadow-glow-sm">
        <span>// INTERACTIVE CLI SANDBOX</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white">
        Test command flags. <br class="hidden sm:inline" />
        <span class="text-gradient-go">Experience exact terminal output.</span>
      </h2>
    </div>

    <!-- Terminal Sandbox Container (Compact & Focused max-w-3xl) -->
    <div class="max-w-3xl mx-auto">
      
      <!-- Command Button Selectors -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mb-5 px-1">
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420] text-cyan-300 border border-[#00ADD8] shadow-glow-sm transition-all active-demo min-h-[34px] active:scale-95"
          data-output="fetch"
        >
          $ kernelview
        </button>
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420]/70 text-slate-400 border border-slate-800 hover:text-slate-200 hover:border-slate-700 transition-all min-h-[34px] active:scale-95"
          data-output="json"
        >
          $ kernelview --json
        </button>
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420]/70 text-slate-400 border border-slate-800 hover:text-slate-200 hover:border-slate-700 transition-all min-h-[34px] active:scale-95"
          data-output="gpu"
        >
          $ kernelview -g
        </button>
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420]/70 text-slate-400 border border-slate-800 hover:text-slate-200 hover:border-slate-700 transition-all min-h-[34px] active:scale-95"
          data-output="net"
        >
          $ kernelview -n
        </button>
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420]/70 text-slate-400 border border-slate-800 hover:text-slate-200 hover:border-slate-700 transition-all min-h-[34px] active:scale-95"
          data-output="proc"
        >
          $ kernelview -p
        </button>
        <button
          type="button"
          class="demo-cmd-btn px-3 py-1.5 rounded-lg font-mono text-xs font-semibold bg-[#0f1420]/70 text-slate-400 border border-slate-800 hover:text-slate-200 hover:border-slate-700 transition-all min-h-[34px] active:scale-95"
          data-output="help"
        >
          $ kernelview --help
        </button>
      </div>

      <!-- Interactive Output Window -->
      <div class="rounded-xl sm:rounded-2xl bg-[#0a0e17] border border-[#00ADD8]/30 shadow-terminal overflow-hidden">
        
        <!-- Header Bar -->
        <div class="bg-[#0f1420] px-3 sm:px-4 py-2 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
            <span class="ml-1.5 font-mono text-[11px] sm:text-xs text-slate-400">interactive-session — bash</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded border border-emerald-800/50 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> ~42.8ms
            </span>
          </div>
        </div>

        <!-- Terminal Output Body (Compact padding & font size) -->
        <div class="p-3.5 sm:p-5 font-mono text-[11px] sm:text-xs bg-[#080c14] text-slate-200 min-h-[290px] overflow-x-auto leading-relaxed overscroll-x-contain">
          
          <!-- Exact Fetch Output View -->
          <div id="out-fetch" class="demo-pane block">
            <div class="text-slate-400 mb-3 sm:mb-4 font-mono text-xs flex items-center gap-1.5 sm:gap-2 flex-wrap">
              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview</span>
            </div>
            
            <div class="flex flex-col md:flex-row gap-4 lg:gap-8 items-start">
              <!-- Left: Fedora ASCII Logo in Soft Cyan-Blue (#38bdf8 / ANSI 75) -->
              <div class="text-[#38bdf8] font-bold select-none whitespace-pre font-mono text-xs sm:text-sm leading-tight flex-shrink-0">
{fedoraAsciiLines.join('\n')}
              </div>

              <!-- Right: System Specs with Bold Cyan Keys & Light Gray Values -->
              <div class="flex-1 space-y-0.5 font-mono text-[11px] sm:text-xs md:text-sm text-slate-200">
                <div class="font-bold text-[#38bdf8] mb-0.5">
                  soumyajit@fedora
                </div>
                <div class="text-slate-500 select-none pb-1">----------------</div>
                
                {fetchSpecs.map((spec) => (
                  <div class="flex flex-col xs:flex-row xs:items-baseline gap-0.5 xs:gap-1.5 min-w-0 py-0.2">
                    <span class="text-[#38bdf8] font-bold xs:min-w-[95px] flex-shrink-0">{spec.key}:</span>
                    <span class="text-slate-300 break-words min-w-0">{spec.value}</span>
                  </div>
                ))}

                <!-- Authentic 2-Row 8-Color ANSI Blocks -->
                <div class="pt-4 sm:pt-5 space-y-1 select-none overflow-x-auto no-scrollbar">
                  <div class="flex gap-1 sm:gap-1.5 flex-nowrap">
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-zinc-950 border border-slate-700/50 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-red-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-green-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-yellow-500 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-[#00ADD8] rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-purple-600 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-cyan-400 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-slate-200 rounded-xs inline-block flex-shrink-0"></span>
                  </div>
