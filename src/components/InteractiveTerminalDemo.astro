                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-green-400 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-yellow-300 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-blue-400 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-purple-400 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-cyan-300 rounded-xs inline-block flex-shrink-0"></span>
                    <span class="w-4 sm:w-6 h-3 sm:h-4 bg-white rounded-xs inline-block flex-shrink-0"></span>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!-- JSON Output View -->
          <div id="out-json" class="demo-pane hidden">
            <div class="text-slate-400 mb-3 sm:mb-4 font-mono text-xs flex items-center gap-1.5 sm:gap-2 flex-wrap">
              <span class="text-emerald-400">soumyajit@fedora</span>:<span class="text-blue-400">~/Projects/KernelView-Go</span>$ <span class="text-white font-bold">./kernelview --json</span>
            </div>
            <pre class="text-cyan-300 font-mono text-xs sm:text-sm whitespace-pre-wrap leading-relaxed"><code>{jsonRawOutput}</code></pre>
