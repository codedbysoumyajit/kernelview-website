---
// Footer.astro
---

<footer class="border-t border-slate-800/80 bg-[#070b13] pt-12 sm:pt-16 pb-10 sm:pb-12 relative overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[350px] sm:w-[600px] h-[180px] bg-[#00ADD8]/5 rounded-full blur-[90px] sm:blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 mb-10 sm:mb-12">
      
      <!-- Brand column -->
      <div class="sm:col-span-2">
        <div class="flex items-center gap-2.5 sm:gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#00ADD8]/20 to-blue-600/10 border border-[#00ADD8]/40 flex items-center justify-center">
            <svg class="w-4 h-4 text-[#00ADD8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="font-bold text-base sm:text-lg text-white">
            Kernel<span class="text-[#00ADD8]">View</span> <span class="text-xs font-mono text-slate-400">Go</span>
          </span>
        </div>
        
        <p class="mt-3 sm:mt-4 text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          Blazing-fast, zero-subprocess system information fetcher and real-time terminal telemetry dashboard engineered in pure Go.
        </p>

        <!-- Badges Strip -->
        <div class="mt-4 sm:mt-6 flex flex-wrap items-center gap-2">
          <a
            href="https://github.com/codedbysoumyajit/KernelView-Go/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[10px] sm:text-[11px] font-mono text-cyan-300 hover:border-[#00ADD8]/40 transition-colors"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#00ADD8]"></span>
            MIT License
          </a>
          <a
            href="https://github.com/codedbysoumyajit/KernelView-Go/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[10px] sm:text-[11px] font-mono text-slate-300 hover:border-[#00ADD8]/40 transition-colors"
          >
            v1.3.2 Latest
          </a>
          <a
            href="https://goreportcard.com/report/github.com/codedbysoumyajit/KernelView-Go"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[10px] sm:text-[11px] font-mono text-emerald-400 hover:border-emerald-500/40 transition-colors"
          >
            Go Report: A+
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-mono font-bold text-slate-200 uppercase tracking-wider mb-3 sm:mb-4">
          Navigation
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm font-sans text-slate-400">
          <li><a href="#features" class="hover:text-[#00ADD8] transition-colors">Features & Architecture</a></li>
          <li><a href="#showcase" class="hover:text-[#00ADD8] transition-colors">Screenshots Showcase</a></li>
          <li><a href="#benchmarks" class="hover:text-[#00ADD8] transition-colors">Performance Benchmarks</a></li>
          <li><a href="#demo" class="hover:text-[#00ADD8] transition-colors">Interactive CLI Sandbox</a></li>
          <li><a href="#platforms" class="hover:text-[#00ADD8] transition-colors">Supported Platforms</a></li>
          <li><a href="#install" class="hover:text-[#00ADD8] transition-colors">Installation Guide</a></li>
        </ul>
      </div>

      <!-- Community & Resources -->
      <div>
        <h4 class="text-xs font-mono font-bold text-slate-200 uppercase tracking-wider mb-3 sm:mb-4">
          Open Source
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm font-sans text-slate-400">
          <li>
            <a
              href="https://github.com/codedbysoumyajit/KernelView-Go"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#00ADD8] transition-colors flex items-center gap-1.5"
            >
              <span>GitHub Repository</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/codedbysoumyajit/KernelView-Go/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#00ADD8] transition-colors flex items-center gap-1.5"
            >
              <span>Releases & Binaries</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/codedbysoumyajit/KernelView-Go/actions/workflows/release.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#00ADD8] transition-colors flex items-center gap-1.5"
            >
              <span>Release CI Status</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/codedbysoumyajit/KernelView-Go/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#00ADD8] transition-colors flex items-center gap-1.5"
            >
              <span>Issue Tracker</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="pt-6 sm:pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left text-[11px] sm:text-xs font-mono text-slate-400">
      <div>
        © 2026 <a href="https://github.com/codedbysoumyajit" target="_blank" class="text-white hover:text-[#00ADD8] transition-colors">Soumyajit</a> (KernelView Go). Released under the <span class="text-slate-300 font-semibold">MIT License</span>.
      </div>
      <div class="flex items-center gap-3">
        <span>Fast, Zero-Subprocess Telemetry</span>
        <span class="text-slate-600">•</span>
        <a href="#top" class="text-[#00ADD8] hover:underline">Back to top ↑</a>
      </div>
    </div>

  </div>
</footer>
