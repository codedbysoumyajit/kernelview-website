---
// InstallSection.astro

const installTabs = [
  {
    id: "install-sh",
    name: "Linux / macOS / BSD",
    badge: "1-Command",
    command: `# Automated multi-architecture installer (Linux, macOS, BSD)
curl -fsSL https://raw.githubusercontent.com/codedbysoumyajit/KernelView-Go/main/install.sh | sh

# Verify installation
kernelview --version`,
    description: "Detects your operating system, CPU architecture (x86_64, ARM64, Apple Silicon, BSD), downloads the release binary, verifies SHA256 checksums, and installs to /usr/local/bin."
  },
  {
    id: "install-win",
    name: "Windows PowerShell",
    badge: "PowerShell",
    command: `# Run via PowerShell as Administrator or standard terminal
irm https://raw.githubusercontent.com/codedbysoumyajit/KernelView-Go/main/install.ps1 | iex

# Verify installation
kernelview --version`,
    description: "Automated PowerShell script for Windows 10/11 (x86_64 and ARM64), adding kernelview to your User PATH with native ConPTY support."
  },
  {
    id: "install-binaries",
    name: "Pre-Built Releases",
    badge: "GitHub",
    command: `# Download directly from GitHub Releases:
# • Linux (x86_64):        kernelview_1.3.0_linux_amd64.tar.gz
# • Linux (ARM64):         kernelview_1.3.0_linux_arm64.tar.gz
# • macOS (Apple Silicon): kernelview_1.3.0_darwin_arm64.tar.gz
# • macOS (Intel):         kernelview_1.3.0_darwin_amd64.tar.gz
# • Windows (x86_64):      kernelview_1.3.0_windows_amd64.zip
# • Windows (ARM64):       kernelview_1.3.0_windows_arm64.zip
# • FreeBSD / OpenBSD / NetBSD release archives available

# Extract and run anywhere with zero runtime dependencies`,
    description: "Single standalone binaries compiled via GoReleaser with stripped symbols (-s -w)."
  },
  {
    id: "install-source",
    name: "Source Build",
    badge: "Go 1.21+",
    command: `# Ensure Go 1.21+ is installed
go version

# Clone repository
git clone https://github.com/codedbysoumyajit/KernelView-Go.git
cd KernelView-Go

# Build stripped release binary
go build -ldflags="-s -w" -o kernelview .

# Install to system path
sudo mv kernelview /usr/local/bin/`,
    description: "Build directly from the latest commit using your local Go toolchain."
  },
  {
    id: "install-pkg",
    name: "Package Roadmap",
    badge: "Planned",
    command: `# Official Package Manager Distribution Status:
# -------------------------------------------------------------
# • Arch Linux (AUR):   Planned (AUR registration temporarily closed, will publish upon reopening)
# • Fedora (DNF COPR):  Coming Very Soon
# • Ubuntu / Debian:    APT PPA Coming Soon
# • macOS Homebrew:     Custom Tap Planned
# • Windows Winget:     Manifest Submission Planned

# In the meantime, please use the 1-command installer:
curl -fsSL https://raw.githubusercontent.com/codedbysoumyajit/KernelView-Go/main/install.sh | sh`,
    description: "Single-command installer is currently the official installation method; native distro repository packaging is actively in progress."
  }
];
---

<section id="install" class="py-16 sm:py-24 lg:py-28 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#00ADD8]/10 text-[#00ADD8] border border-[#00ADD8]/30 text-xs font-mono font-medium mb-3 sm:mb-4">
        <span>// GETTING STARTED</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Install KernelView in <br class="hidden sm:inline" />
        <span class="text-gradient-go">under 3 seconds.</span>
      </h2>
      <p class="mt-3 text-slate-400 text-sm sm:text-base lg:text-lg">
        Single static binary. Zero runtime dependencies. Choose your preferred method below.
      </p>
    </div>

    <!-- Tab Selector Buttons (Centered flex-wrap with zero clipping) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mb-6 px-1 max-w-4xl mx-auto">
      {installTabs.map((tab, idx) => (
        <button
          type="button"
          data-install-target={tab.id}
          class={`install-tab-btn px-3 sm:px-4 py-2 rounded-xl font-mono text-xs font-semibold transition-all duration-200 flex items-center gap-1.5 flex-shrink-0 border ${
            idx === 0
              ? 'bg-[#0f1420] text-cyan-300 border-[#00ADD8] shadow-glow-sm active-install-tab'
              : 'bg-[#0f1420]/70 text-slate-400 border-slate-800 hover:text-slate-200 hover:border-slate-700'
          }`}
        >
          <span>{tab.name}</span>
          <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-900 text-slate-400 border border-slate-800">
            {tab.badge}
          </span>
        </button>
      ))}
    </div>

    <!-- Installation Window Card -->
    <div class="max-w-4xl mx-auto">
      <div class="rounded-xl sm:rounded-2xl bg-[#0f1420] border border-[#00ADD8]/30 shadow-terminal overflow-hidden">
        
        <!-- Header Bar with Traffic Lights -->
        <div class="bg-[#0a0e17] px-4 py-3 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
            <span class="ml-2 font-mono text-xs text-slate-400 hidden sm:inline">installer — bash</span>
          </div>

          <div class="flex items-center gap-2">
            <a
              id="releases-link-btn"
              href="https://github.com/codedbysoumyajit/KernelView-Go/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden px-2.5 py-1 rounded bg-[#00ADD8] hover:bg-[#00c7fd] text-slate-950 font-bold text-xs font-mono transition-all items-center gap-1"
            >
              <span>GitHub Releases</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <button
              id="global-install-copy-btn"
              class="px-3 py-1 rounded-lg bg-slate-800/90 hover:bg-[#00ADD8]/20 text-slate-300 hover:text-cyan-300 border border-slate-700 hover:border-[#00ADD8]/50 text-xs font-mono transition-all flex items-center gap-1.5"
              data-copy={installTabs[0].command}
            >
              <svg class="w-3.5 h-3.5 text-[#00ADD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span class="copy-text">Copy Script</span>
            </button>
          </div>
        </div>

        <!-- Code Block Panes -->
        <div class="p-4 sm:p-6 bg-[#0b101b] relative">
          {installTabs.map((tab, idx) => (
            <div
              id={tab.id}
              class={`install-pane ${idx === 0 ? 'block' : 'hidden'}`}
              data-cmd={tab.command}
            >
              <p class="text-xs text-slate-400 font-sans leading-relaxed mb-3">
                {tab.description}
              </p>

              <!-- Terminal Code Box -->
              <div class="rounded-xl bg-[#070a12] border border-slate-800/90 p-3 sm:p-4 font-mono text-xs sm:text-sm text-slate-200 overflow-x-auto shadow-inner">
                <pre class="leading-relaxed whitespace-pre-wrap"><code class="text-cyan-400">{tab.command}</code></pre>
              </div>
            </div>
          ))}
        </div>

        <!-- Terminal Footer Flags Matrix -->
        <div class="bg-[#080c14] px-4 sm:px-6 py-3.5 sm:py-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-slate-400">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-slate-400">Supported Flags:</span>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-f, --fast</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-l, --live</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-g, --gpu</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-n, --network</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">--json</code>
          </div>

          <a
            href="https://github.com/codedbysoumyajit/KernelView-Go/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#00ADD8] hover:underline flex items-center gap-1 text-xs font-semibold"
          >
            <span>GitHub Releases & Checksums</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const installButtons = document.querySelectorAll<HTMLButtonElement>('.install-tab-btn');
  const installPanes = document.querySelectorAll<HTMLDivElement>('.install-pane');
  const globalCopyBtn = document.getElementById('global-install-copy-btn') as HTMLButtonElement | null;
  const releasesLinkBtn = document.getElementById('releases-link-btn') as HTMLAnchorElement | null;

  installButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-install-target');

      installButtons.forEach((b) => {
        b.classList.remove('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-install-tab');
        b.classList.add('bg-[#0f1420]/70', 'text-slate-400', 'border-slate-800');
      });

      btn.classList.remove('bg-[#0f1420]/70', 'text-slate-400', 'border-slate-800');
      btn.classList.add('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-install-tab');

      installPanes.forEach((pane) => {
        if (pane.id === targetId) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
          if (globalCopyBtn) {
            globalCopyBtn.setAttribute('data-copy', pane.getAttribute('data-cmd') || '');
          }
          if (releasesLinkBtn) {
            if (targetId === 'install-binaries') {
              releasesLinkBtn.classList.remove('hidden');
              releasesLinkBtn.classList.add('inline-flex');
            } else {
              releasesLinkBtn.classList.remove('inline-flex');
              releasesLinkBtn.classList.add('hidden');
            }
          }
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });
    });
  });

  if (globalCopyBtn) {
    globalCopyBtn.addEventListener('click', async () => {
      const cmd = globalCopyBtn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(cmd);
        const textSpan = globalCopyBtn.querySelector('.copy-text');
        if (textSpan) textSpan.textContent = 'Copied!';
        if (window.showToast) window.showToast('Copied installation instructions to clipboard!');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Copy Script';
        }, 1500);
      } catch (e) {
        console.error(e);
      }
    });
  }
</script>
