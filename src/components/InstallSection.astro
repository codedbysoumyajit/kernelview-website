---
// InstallSection.astro

const installTabs = [
  {
    id: "install-ppa",
    name: "Ubuntu / Debian",
    badge: "APT PPA",
    tag: "Native Debian/Ubuntu Package",
    shell: "bash — apt",
    command: `# Add official Launchpad PPA repository
sudo add-apt-repository ppa:codedbysoumyajit/kernelview
sudo apt update
sudo apt install kernelview

# Verify installation
kernelview --version`,
    description: "Official Ubuntu Launchpad PPA repository. Automatically receives updates alongside standard system upgrades via apt update & upgrade.",
    distros: ["Ubuntu 24.04 (Noble)", "Ubuntu 22.04 (Jammy)", "Ubuntu 20.04 (Focal)", "Linux Mint", "Pop!_OS"],
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/></svg>`
  },
  {
    id: "install-copr",
    name: "Fedora / RHEL",
    badge: "DNF COPR",
    tag: "Native RPM Package",
    shell: "bash — dnf",
    command: `# Enable official Fedora Copr repository
sudo dnf copr enable codedbysoumyajit/kernelview
sudo dnf install kernelview

# Verify installation
kernelview --version`,
    description: "Official Fedora Copr repository for Fedora Linux, CentOS Stream, RHEL, and openSUSE. Easily managed and auto-updated with DNF.",
    distros: ["Fedora 39 / 40 / 41", "CentOS Stream 9 / 10", "RHEL 8 / 9"],
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  },
  {
    id: "install-sh",
    name: "Linux / macOS / BSD",
    badge: "1-Command",
    tag: "Multi-Arch Auto-Installer",
    shell: "sh — universal",
    command: `# Automated multi-architecture installer (Linux, macOS Apple Silicon/Intel, BSD)
curl -fsSL https://raw.githubusercontent.com/codedbysoumyajit/KernelView-Go/main/install.sh | sh

# Verify installation
kernelview --version`,
    description: "Intelligent auto-detection script. Identifies OS & CPU architecture (x86_64, ARM64, Apple Silicon M1-M4, FreeBSD), verifies SHA256 sums, and installs to /usr/local/bin.",
    distros: ["Arch Linux", "macOS Apple Silicon", "macOS Intel", "Alpine Linux", "Void Linux", "FreeBSD / OpenBSD"],
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`
  },
  {
    id: "install-win",
    name: "Windows PowerShell",
    badge: "PowerShell",
    tag: "Native ConPTY Console",
    shell: "powershell.exe",
    command: `# Run in PowerShell (Administrator or standard terminal)
irm https://raw.githubusercontent.com/codedbysoumyajit/KernelView-Go/main/install.ps1 | iex

# Verify installation
kernelview --version`,
    description: "One-line automated PowerShell script for Windows 10 & 11 (x86_64 and ARM64). Automatically configures user environment PATH with ConPTY 24-bit TrueColor support.",
    distros: ["Windows 11", "Windows 10", "Windows Terminal", "PowerShell 7+", "Windows on ARM"],
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>`
  }
];
---

<section id="install" class="py-16 sm:py-24 lg:py-28 relative overflow-hidden">
  <!-- Subtle Ambient Background Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[650px] h-[350px] bg-[#00ADD8]/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00ADD8]/10 text-[#00ADD8] border border-[#00ADD8]/30 text-xs font-mono font-medium mb-3 sm:mb-4 shadow-glow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#00ADD8] animate-pulse"></span>
        <span>// GETTING STARTED</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Install KernelView in <br class="hidden sm:inline" />
        <span class="text-gradient-go">under 3 seconds.</span>
      </h2>
      <p class="mt-3 sm:mt-4 text-slate-400 text-sm sm:text-base lg:text-lg max-w-2xl mx-auto">
        Single static native binary. Zero runtime dependencies. Choose your distribution or operating system below.
      </p>
    </div>

    <!-- Redesigned Segmented Method Switcher Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3.5 mb-6 sm:mb-8 max-w-4xl mx-auto">
      {installTabs.map((tab, idx) => (
        <button
          type="button"
          data-install-target={tab.id}
          data-shell={tab.shell}
          class={`install-tab-btn group relative p-2.5 sm:p-4 rounded-xl sm:rounded-2xl text-left transition-all duration-200 border flex flex-col justify-between active:scale-[0.98] ${
            idx === 0
              ? 'bg-[#0f1420] text-cyan-300 border-[#00ADD8] shadow-glow-sm active-install-tab ring-1 ring-[#00ADD8]/50'
              : 'bg-[#0b101c]/80 text-slate-400 border-slate-800/80 hover:bg-[#0f1420]/70 hover:text-slate-200 hover:border-slate-700'
          }`}
        >
          <div class="flex items-center justify-between w-full mb-1.5 sm:mb-2">
            <div class={`tab-icon-wrapper w-6 h-6 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center transition-colors ${
              idx === 0 ? 'bg-[#00ADD8]/20 text-[#00ADD8]' : 'bg-slate-900 text-slate-400 group-hover:text-slate-200'
            }`}>
              <Fragment set:html={tab.icon} />
            </div>
            <span class={`tab-badge text-[9px] sm:text-[10px] font-mono px-1.5 py-0.5 rounded border transition-colors ${
              idx === 0
                ? 'bg-[#00ADD8]/20 text-cyan-300 border-[#00ADD8]/40'
                : 'bg-slate-900/90 text-slate-500 border-slate-800'
            }`}>
              {tab.badge}
            </span>
          </div>

          <div>
            <div class="font-bold text-[11px] xs:text-xs sm:text-sm text-white tracking-tight truncate">
              {tab.name}
            </div>
            <div class="text-[9px] xs:text-[10px] sm:text-[11px] font-mono text-slate-400 truncate mt-0.5">
              {tab.tag}
            </div>
          </div>
        </button>
      ))}
    </div>

    <!-- Redesigned Terminal Window Card -->
    <div class="max-w-4xl mx-auto">
      <div class="rounded-2xl bg-[#0a0e17] border border-[#00ADD8]/30 shadow-terminal overflow-hidden backdrop-blur-xl">
        
        <!-- Header Bar with Traffic Lights & Action Buttons -->
        <div class="bg-[#0f1420] px-3.5 sm:px-5 py-2.5 sm:py-3 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ff5f56] shadow-sm"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ffbd2e] shadow-sm"></div>
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#27c93f] shadow-sm"></div>
            <div class="h-3 w-px bg-slate-800 ml-1 mr-1"></div>
            <span id="terminal-shell-title" class="font-mono text-[11px] sm:text-xs text-slate-400 truncate max-w-[140px] sm:max-w-none">
              {installTabs[0].shell}
            </span>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="global-install-copy-btn"
              class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg bg-slate-900 hover:bg-[#00ADD8]/20 text-slate-200 hover:text-cyan-300 border border-slate-700 hover:border-[#00ADD8]/50 text-xs font-mono font-medium transition-all flex items-center gap-1.5 shadow-sm active:scale-95 min-h-[30px] sm:min-h-[34px]"
              data-copy={installTabs[0].command}
              title="Copy installation commands"
            >
              <svg class="copy-icon w-3.5 h-3.5 text-[#00ADD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span class="copy-text text-[11px] sm:text-xs">Copy Commands</span>
            </button>
          </div>
        </div>

        <!-- Terminal Panes Body -->
        <div class="p-4 sm:p-6 bg-[#070b13] relative">
          {installTabs.map((tab, idx) => (
            <div
              id={tab.id}
              class={`install-pane ${idx === 0 ? 'block' : 'hidden'}`}
              data-cmd={tab.command}
              data-shell={tab.shell}
            >
              <!-- Method Description -->
              <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed mb-3">
                {tab.description}
              </p>

              <!-- Supported Distros Tag Pill Strip -->
              <div class="flex items-center gap-1.5 flex-wrap mb-4">
                <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider mr-1">Verified on:</span>
                {tab.distros.map((d) => (
                  <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-900/90 text-slate-300 border border-slate-800/90">
                    {d}
                  </span>
                ))}
              </div>

              <!-- Terminal Code Box -->
              <div class="rounded-xl bg-[#04060a] border border-slate-800/90 p-3.5 sm:p-4 font-mono text-xs sm:text-sm text-slate-200 overflow-x-auto shadow-inner touch-pan-x overscroll-x-contain">
                <pre class="leading-relaxed whitespace-pre-wrap"><code class="text-cyan-300 font-mono">{tab.command}</code></pre>
              </div>
            </div>
          ))}
        </div>

        <!-- Terminal Footer Flags & Release Matrix -->
        <div class="bg-[#0c111c] px-4 sm:px-6 py-3.5 sm:py-4 border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-slate-400">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-slate-400 text-xs">Runtime Flags:</span>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-f, --fast</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-l, --live</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-g, --gpu</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">-n, --network</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800 text-[11px]">--json</code>
          </div>

          <a
            href="https://github.com/codedbysoumyajit/KernelView-Go/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#00ADD8] hover:text-cyan-200 hover:underline flex items-center gap-1.5 text-xs font-semibold flex-shrink-0 transition-colors"
          >
            <span>GitHub Releases & Checksums</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

      </div>
    </div>

    <!-- 3 Key Deployment Highlights (Below Terminal) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-4 max-w-4xl mx-auto mt-6 sm:mt-8">
      <div class="p-4 rounded-xl bg-[#0c111c]/60 border border-slate-800/80 backdrop-blur-sm">
        <div class="text-xs font-mono font-bold text-white flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00ADD8]"></span>
          <span>Zero Runtime Dependencies</span>
        </div>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed font-sans">
          Pure Go static binaries with stripped symbols. Zero external dynamic C library dependencies or glibc version conflicts.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-[#0c111c]/60 border border-slate-800/80 backdrop-blur-sm">
        <div class="text-xs font-mono font-bold text-white flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Automatic Package Updates</span>
        </div>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed font-sans">
          Native APT PPA and DNF Copr repositories ensure KernelView updates smoothly alongside standard system maintenance cycles.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-[#0c111c]/60 border border-slate-800/80 backdrop-blur-sm">
        <div class="text-xs font-mono font-bold text-white flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span>Multi-Arch Native Artifacts</span>
        </div>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed font-sans">
          First-class performance on x86_64, ARM64, and Apple Silicon (M1–M4). Boots and resolves full telemetry in &lt;50ms.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  const installButtons = document.querySelectorAll<HTMLButtonElement>('.install-tab-btn');
  const installPanes = document.querySelectorAll<HTMLDivElement>('.install-pane');
  const globalCopyBtn = document.getElementById('global-install-copy-btn') as HTMLButtonElement | null;
  const terminalShellTitle = document.getElementById('terminal-shell-title');

  installButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-install-target');
      const shellName = btn.getAttribute('data-shell') || 'bash';

      // Reset all tab button styles
      installButtons.forEach((b) => {
        b.classList.remove('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-install-tab', 'ring-1', 'ring-[#00ADD8]/50');
        b.classList.add('bg-[#0b101c]/80', 'text-slate-400', 'border-slate-800/80');

        const iconWrapper = b.querySelector('.tab-icon-wrapper');
        if (iconWrapper) {
          iconWrapper.classList.remove('bg-[#00ADD8]/20', 'text-[#00ADD8]');
          iconWrapper.classList.add('bg-slate-900', 'text-slate-400');
        }

        const badge = b.querySelector('.tab-badge');
        if (badge) {
          badge.classList.remove('bg-[#00ADD8]/20', 'text-cyan-300', 'border-[#00ADD8]/40');
          badge.classList.add('bg-slate-900/90', 'text-slate-500', 'border-slate-800');
        }
      });

      // Activate clicked button
      btn.classList.remove('bg-[#0b101c]/80', 'text-slate-400', 'border-slate-800/80');
      btn.classList.add('bg-[#0f1420]', 'text-cyan-300', 'border-[#00ADD8]', 'shadow-glow-sm', 'active-install-tab', 'ring-1', 'ring-[#00ADD8]/50');

      const activeIcon = btn.querySelector('.tab-icon-wrapper');
      if (activeIcon) {
        activeIcon.classList.remove('bg-slate-900', 'text-slate-400');
        activeIcon.classList.add('bg-[#00ADD8]/20', 'text-[#00ADD8]');
      }

      const activeBadge = btn.querySelector('.tab-badge');
      if (activeBadge) {
        activeBadge.classList.remove('bg-slate-900/90', 'text-slate-500', 'border-slate-800');
        activeBadge.classList.add('bg-[#00ADD8]/20', 'text-cyan-300', 'border-[#00ADD8]/40');
      }

      // Update terminal shell title
      if (terminalShellTitle) {
        terminalShellTitle.textContent = shellName;
      }

      // Switch pane
      installPanes.forEach((pane) => {
        if (pane.id === targetId) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
          if (globalCopyBtn) {
            globalCopyBtn.setAttribute('data-copy', pane.getAttribute('data-cmd') || '');
          }
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });
    });
  });

  if (globalCopyBtn) {
    globalCopyBtn.addEventListener('click', async () => {
      const cmd = globalCopyBtn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(cmd);
        const textSpan = globalCopyBtn.querySelector('.copy-text');
        if (textSpan) textSpan.textContent = 'Copied!';
        if (window.showToast) window.showToast('Copied installation instructions to clipboard!');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Copy Commands';
        }, 1500);
      } catch (e) {
        console.error(e);
      }
    });
  }
</script>
